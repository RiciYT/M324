# Hono API base URL (Vite dev server defaults to localhost:3000 if unset)
VITE_SERVER_URL=http://localhost:3000

# Grafana dashboard URL used by the /stats page iframe.
# Leave empty in environments without an embeddable Grafana (the page will
# show a setup hint instead).
VITE_GRAFANA_URL=http://localhost:3001/d/m324-observability?orgId=1&kiosk=tv&refresh=30s
