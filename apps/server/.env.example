# Database (Docker Compose default for local development)
DATABASE_URL=postgres://postgres:password@localhost:5432/M324

# Better Auth — secret must be at least 32 characters
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Web client origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Runtime
NODE_ENV=development

# Google OAuth — leave empty to disable the Google sign-in button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Loki log shipping — leave LOKI_URL empty to disable the transport.
# Local default: http://localhost:3100/loki/api/v1/push
LOKI_URL=http://localhost:3100/loki/api/v1/push
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_SERVICE_NAME=m324-server
